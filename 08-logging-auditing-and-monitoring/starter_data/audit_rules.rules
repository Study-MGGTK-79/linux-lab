# ==============================================================================
# Linux Audit Framework (auditd) Production Ruleset
# Mapped to MITRE ATT&CK for Enterprise (Linux Matrix) & CIS Benchmark
# Path: /etc/audit/rules.d/hardening-mitre.rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Инициализация и настройки производительности
# ------------------------------------------------------------------------------
# Сброс всех предыдущих правил
-D

# Размер буфера ядра в сообщениях (увеличен для предотвращения потери событий при пиках)
-b 8192

# Действие при переполнении буфера: 1 - запись предупреждения через printk в dmesg
-f 1

# Скорость генерации событий (0 - без ограничений)
-r 0

# ------------------------------------------------------------------------------
# 2. MITRE ATT&CK T1059.004: Execution via Unix Shell
# Логирование запуска всех команд интерактивными пользователями
# Фильтры: архитектура b64, реальный UID >= 1000, исключение системных демонов (-1 / 4294967295)
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S execve,execveat -F auid>=1000 -F auid!=4294967295 -k mitre_execve

# ------------------------------------------------------------------------------
# 3. MITRE ATT&CK T1003.008: Credential Access (/etc/shadow, /etc/gshadow)
# Мониторинг попыток чтения, записи и смены атрибутов файлов паролей
# ------------------------------------------------------------------------------
-w /etc/shadow -p rwa -k mitre_credential_access
-w /etc/gshadow -p rwa -k mitre_credential_access
-w /etc/security/opasswd -p rwa -k mitre_credential_access

# ------------------------------------------------------------------------------
# 4. MITRE ATT&CK T1136 & T1548.003: Persistence & Privilege Escalation
# Мониторинг учетных записей пользователей, групп и прав sudo
# ------------------------------------------------------------------------------
-w /etc/passwd -p wa -k mitre_account_privesc
-w /etc/group -p wa -k mitre_account_privesc
-w /etc/sudoers -p wa -k mitre_account_privesc
-w /etc/sudoers.d/ -p wa -k mitre_account_privesc

# ------------------------------------------------------------------------------
# 5. MITRE ATT&CK T1548.001: Abuse Elevation Control (SUID/SGID & setuid syscalls)
# Перехват системных вызовов смены идентификаторов пользователя
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid,setresuid,setresgid -F auid>=1000 -F auid!=4294967295 -k mitre_setuid_escalation

# ------------------------------------------------------------------------------
# 6. MITRE ATT&CK T1070: Indicator Removal on Host (Log Tampering & File Deletion)
# Перехват системных вызовов удаления файлов и усечения логов в каталоге /var/log
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,truncate,ftruncate -F dir=/var/log -k mitre_log_tampering

# ------------------------------------------------------------------------------
# 7. MITRE ATT&CK T1053.003: Scheduled Task / Persistence (Cron & Timers)
# ------------------------------------------------------------------------------
-w /etc/crontab -p wa -k mitre_persistence_cron
-w /etc/cron.d/ -p wa -k mitre_persistence_cron
-w /etc/cron.daily/ -p wa -k mitre_persistence_cron
-w /etc/cron.hourly/ -p wa -k mitre_persistence_cron
-w /etc/cron.weekly/ -p wa -k mitre_persistence_cron
-w /etc/cron.monthly/ -p wa -k mitre_persistence_cron
-w /var/spool/cron/ -p wa -k mitre_persistence_cron

# ------------------------------------------------------------------------------
# 8. MITRE ATT&CK T1055: Process Injection & Debugging
# Контроль отладки и инъекций шеллкода в чужие процессы (ptrace)
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S ptrace -k mitre_process_injection

# ------------------------------------------------------------------------------
# 9. Блокировка правил в ядре (Immutable Mode)
# ПРИМЕЧАНИЕ: После применения этой директивы правила нельзя изменить или отключить
# даже пользователю root без полной перезагрузки сервера!
# ------------------------------------------------------------------------------
-e 2
